{
  "name": "wexample/symfony-mail-demo",
  "description": "Demo of symfony-mail: sample mails to fill the development mailbox",
  "version": "2.0.12",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyMailDemo\\": "src/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "wexample/symfony-design-system": ">=35.0.0",
    "wexample/symfony-helpers": ">=16.0.0",
    "wexample/symfony-loader": ">=23.0.0",
    "wexample/symfony-mail": ">=2.0.0",
    "wexample/symfony-mail-ds": ">=2.1.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}